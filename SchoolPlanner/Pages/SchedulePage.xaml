<Page x:Class="SchoolPlanner.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Расписание"
      Background="#F0F2F5">

    <Page.Resources>
        <!-- Эффект тени -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" Opacity="0.08" ShadowDepth="3"/>

        <!-- Стиль для карточек -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- Стиль для кнопок -->
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для маленьких кнопок -->
        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource MainButtonStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- Стиль для комбобоксов -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Grid.ColumnSpan="2" 
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" 
                                                                  Content="{TemplateBinding Content}" 
                                                                  HorizontalAlignment="Left" 
                                                                  VerticalAlignment="Center"
                                                                  Margin="10,0,0,0"/>
                                                <Path Grid.Column="1" 
                                                      Data="M0,0 L10,0 L5,5 Z" 
                                                      Fill="#666666" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentPresenter" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              IsHitTestVisible="False" 
                                              Margin="10,8,30,8"
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid MaxHeight="200">
                                    <Border x:Name="DropDownBorder" 
                                            Background="White" 
                                            BorderBrush="#E0E0E0" 
                                            BorderThickness="1" 
                                            CornerRadius="6">
                                        <ScrollViewer x:Name="ScrollViewer">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для тегов статуса -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="#E3F2FD"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="0" 
                Style="{StaticResource CardStyle}" 
                Margin="12" 
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnBack" 
                       Grid.Column="0" 
                       Content="← На главную" 
                       Style="{StaticResource MainButtonStyle}"
                       Background="#78909C"
                       Padding="16,10"
                       Width="140"
                       Click="btnBack_Click"/>

                <TextBlock Grid.Column="1" 
                          Text="📅 Расписание уроков" 
                          FontSize="22" 
                          FontWeight="Bold"
                          Foreground="#1976D2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>

                <!-- Поиск -->
                <Border Grid.Column="2" 
                        Background="#F5F7FA" 
                        CornerRadius="8" 
                        Padding="2"
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        Height="42" 
                        Width="250"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtSearch" 
                                 Grid.Column="0" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Padding="12,0,10,0" 
                                 VerticalAlignment="Center" 
                                 FontSize="13" 
                                 Foreground="#555555"/>
                        <Button x:Name="btnSearch" 
                                Grid.Column="1" 
                                Content="🔍" 
                                Width="36" 
                                Height="36" 
                                Margin="0,0,5,0" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                FontSize="16" 
                                Cursor="Hand" 
                                Click="btnSearch_Click"/>
                    </Grid>
                </Border>

                <!-- Роль -->
                <Border Grid.Column="3"
                        Background="#E3F2FD"
                        CornerRadius="8"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="txtRoleIndicator" 
                               Text="👤 УВР" 
                               Foreground="#1976D2"
                               FontWeight="SemiBold"
                               FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ -->
            <Border Grid.Column="0" 
                    Style="{StaticResource CardStyle}" 
                    Background="White"
                    Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,5,0">
                    <StackPanel Margin="16">
                        <TextBlock Text="📋 Расписание" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#1976D2" 
                                  Margin="0,0,0,15"/>

                        <TextBlock Text="📆 Период" Foreground="#757575" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbSchedule" 
                                  Style="{StaticResource ComboBoxStyle}"
                                  SelectionChanged="cmbSchedule_SelectionChanged"/>

                        <Border x:Name="statusBadge" 
                                Style="{StaticResource StatusBadgeStyle}" 
                                Margin="0,0,0,15">
                            <TextBlock x:Name="txtScheduleStatus" 
                                       Text="Черновик" 
                                       Foreground="#1976D2" 
                                       FontWeight="SemiBold" 
                                       FontSize="12"/>
                        </Border>

                        <Separator Background="#F0F0F0" Height="1" Margin="0,0,0,15"/>

                        <TextBlock Text="🔍 Фильтры" 
                                  FontSize="15" 
                                  FontWeight="SemiBold" 
                                  Foreground="#333333" 
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Класс" Foreground="#757575" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbClassFilter" 
                                  Style="{StaticResource ComboBoxStyle}"
                                  SelectionChanged="cmbClassFilter_SelectionChanged"/>

                        <TextBlock Text="Учитель" Foreground="#757575" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbTeacherFilter" 
                                  Style="{StaticResource ComboBoxStyle}"
                                  SelectionChanged="cmbTeacherFilter_SelectionChanged"/>

                        <TextBlock Text="День недели" Foreground="#757575" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbDayFilter" 
                                  Style="{StaticResource ComboBoxStyle}"
                                  SelectionChanged="cmbDayFilter_SelectionChanged">
                            <ComboBoxItem Content="Все дни"/>
                            <ComboBoxItem Content="Понедельник"/>
                            <ComboBoxItem Content="Вторник"/>
                            <ComboBoxItem Content="Среда"/>
                            <ComboBoxItem Content="Четверг"/>
                            <ComboBoxItem Content="Пятница"/>
                        </ComboBox>

                        <Button x:Name="btnResetFilters" 
                                Content="🔄 Сбросить фильтры" 
                                Style="{StaticResource MainButtonStyle}"
                                Background="#78909C"
                                Padding="12,8"
                                Margin="0,0,0,15"
                                Click="btnResetFilters_Click"/>

                        <Separator Background="#F0F0F0" Height="1" Margin="0,0,0,15"/>

                        <TextBlock Text="🎨 Отображение" 
                                  FontSize="15" 
                                  FontWeight="SemiBold" 
                                  Foreground="#333333" 
                                  Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Размер:" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                            <Button x:Name="btnFontSmall" Content="A" Width="32" Height="28" 
                                    Style="{StaticResource MainButtonStyle}" Background="#B0BEC5" 
                                    FontSize="11" Click="btnFontSmall_Click" Margin="0,0,4,0"/>
                            <Button x:Name="btnFontMedium" Content="A" Width="32" Height="28" 
                                    Style="{StaticResource MainButtonStyle}" Background="#42A5F5" 
                                    FontSize="14" Click="btnFontMedium_Click" Margin="0,0,4,0"/>
                            <Button x:Name="btnFontLarge" Content="A" Width="32" Height="28" 
                                    Style="{StaticResource MainButtonStyle}" Background="#66BB6A" 
                                    FontSize="17" Click="btnFontLarge_Click" Margin="0,0,4,0"/>
                            <Button x:Name="btnFontXLarge" Content="A" Width="35" Height="28" 
                                    Style="{StaticResource MainButtonStyle}" Background="#EF5350" 
                                    FontSize="20" Click="btnFontXLarge_Click"/>
                        </StackPanel>

                        <Button x:Name="btnCompactMode" 
                                Content="📐 Сжать расписание" 
                                Style="{StaticResource MainButtonStyle}"
                                Background="#FFA726"
                                Padding="12,8"
                                Margin="0,0,0,8"
                                Click="btnCompactMode_Click"/>

                        <Button x:Name="btnNormalMode" 
                                Content="📐 Обычный режим" 
                                Style="{StaticResource MainButtonStyle}"
                                Background="#42A5F5"
                                Padding="12,8"
                                Margin="0,0,0,8"
                                Click="btnNormalMode_Click" 
                                Visibility="Collapsed"/>

                        <CheckBox x:Name="chkShowLessonPlans" 
                                  Content="📖 Показывать планы уроков" 
                                  IsChecked="True" 
                                  Foreground="#555555" 
                                  FontSize="12" 
                                  Margin="0,0,0,15"
                                  Checked="chkShowLessonPlans_Checked" 
                                  Unchecked="chkShowLessonPlans_Unchecked"/>

                        <Separator Background="#F0F0F0" Height="1" Margin="0,0,0,15"/>

                        <!-- РЕЗУЛЬТАТЫ ПОИСКА -->
                        <StackPanel x:Name="searchResultsPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="🔎 Результаты поиска:" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="#1976D2" Margin="0,0,0,8"/>
                            <TextBlock x:Name="txtSearchResultsCount" Text="Найдено: 0" 
                                       Foreground="#757575" FontSize="12" Margin="0,0,0,8"/>
                            <ListView x:Name="lvSearchResults" MaxHeight="180" 
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                      BorderThickness="0" SelectionChanged="lvSearchResults_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" 
                                                Padding="10,8" Cursor="Hand" Background="#F8F9FA"
                                                MouseLeftButtonUp="SearchResult_MouseLeftButtonUp">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DayOfWeek}" FontWeight="Bold" Foreground="#1976D2" FontSize="12"/>
                                                    <TextBlock Text=", " Foreground="#666666" FontSize="12"/>
                                                    <TextBlock Text="{Binding LessonNumber}" FontWeight="Bold" Foreground="#1976D2" FontSize="12"/>
                                                    <TextBlock Text=" урок" Foreground="#666666" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" 
                                                           FontSize="13" Foreground="#333333"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Class}" Foreground="#43A047" FontSize="11"/>
                                                    <TextBlock Text=" · " Foreground="#666666" FontSize="11"/>
                                                    <TextBlock Text="{Binding Teacher}" Foreground="#EF6C00" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Room}" Foreground="#757575" FontSize="10"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button x:Name="btnClearSearch" 
                                    Content="✕ Очистить" 
                                    Style="{StaticResource MainButtonStyle}"
                                    Background="#78909C"
                                    Padding="10,6"
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Click="btnClearSearch_Click"/>
                        </StackPanel>

                        <!-- ПАНЕЛЬ УВР -->
                        <StackPanel x:Name="uvrPanel" Visibility="Collapsed">
                            <Separator Background="#F0F0F0" Height="1" Margin="0,0,0,15"/>
                            <TextBlock Text="⚙️ Управление" FontSize="15" FontWeight="Bold" 
                                       Foreground="#D32F2F" Margin="0,0,0,12"/>

                            <Button x:Name="btnNewSchedule" 
                                    Content="➕ Создать расписание" 
                                    Style="{StaticResource MainButtonStyle}"
                                    Background="#43A047"
                                    Padding="12,9"
                                    Margin="0,0,0,6"
                                    Click="btnNewSchedule_Click"/>
                            <Button x:Name="btnEditSchedule" 
                                    Content="✏️ Редактировать" 
                                    Style="{StaticResource MainButtonStyle}"
                                    Background="#1E88E5"
                                    Padding="12,9"
                                    Margin="0,0,0,6"
                                    Click="btnEditSchedule_Click"/>
                            <Button x:Name="btnApproveSchedule" 
                                    Content="✅ Утвердить" 
                                    Style="{StaticResource MainButtonStyle}"
                                    Background="#43A047"
                                    Padding="12,9"
                                    Margin="0,0,0,6"
                                    Click="btnApproveSchedule_Click"/>
                            <Button x:Name="btnGenerateSchedule" 
                                    Content="⚡ Автогенерация" 
                                    Style="{StaticResource MainButtonStyle}"
                                    Background="#FB8C00"
                                    Padding="12,9"
                                    Margin="0,0,0,6"
                                    Click="btnGenerateSchedule_Click"/>
                            <Button x:Name="btnDeleteSchedule" 
                                    Content="🗑️ Удалить" 
                                    Style="{StaticResource MainButtonStyle}"
                                    Background="#E53935"
                                    Padding="12,9"
                                    Margin="0,0,0,6"
                                    Click="btnDeleteSchedule_Click"/>
                            <Button x:Name="btnExportScheduleUvr" 
                                    Content="📄 Экспорт PDF" 
                                    Style="{StaticResource MainButtonStyle}"
                                    Background="#8E24AA"
                                    Padding="12,9"
                                    Margin="0,0,0,6"
                                    Click="btnExportSchedule_Click"/>
                        </StackPanel>

                        <!-- ПАНЕЛЬ УЧИТЕЛЯ -->
                        <StackPanel x:Name="teacherPanel" Visibility="Collapsed">
                            <Separator Background="#F0F0F0" Height="1" Margin="0,0,0,15"/>

                            <Border Background="#E3F2FD" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <TextBlock Text="ℹ️ В расписании отображаются только ваши уроки" 
                                           Foreground="#1976D2" FontSize="12" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="📝 Мои заметки" FontSize="15" FontWeight="Bold" 
                                       Foreground="#1976D2" Margin="0,0,0,12"/>
                            <TextBlock Text="Выберите урок в расписании, чтобы добавить заметку" 
                                       Foreground="#757575" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtNote" Height="70" Padding="12" 
                                     BorderBrush="#E0E0E0" BorderThickness="1" 
                                     TextWrapping="Wrap" AcceptsReturn="True" IsEnabled="False"
                                     FontSize="13"/>
                            <Button x:Name="btnSaveNote" 
                                    Content="💾 Сохранить заметку" 
                                    Style="{StaticResource MainButtonStyle}"
                                    Background="#1E88E5"
                                    Padding="12,8"
                                    Margin="0,8,0,0"
                                    IsEnabled="False"
                                    Click="btnSaveNote_Click"/>
                            <Button x:Name="btnExportScheduleTeacher" 
                                    Content="📄 Экспорт PDF" 
                                    Style="{StaticResource MainButtonStyle}"
                                    Background="#8E24AA"
                                    Padding="12,8"
                                    Margin="0,8,0,0"
                                    Click="btnExportSchedule_Click"/>
                        </StackPanel>

                        <Separator Background="#F0F0F0" Height="1" Margin="0,10,0,0"/>
                        <TextBlock x:Name="txtModeInfo" 
                                   FontSize="11" 
                                   Foreground="#999999" 
                                   Margin="0,8,0,0" 
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ПРАВАЯ ПАНЕЛЬ - ТАБЛИЦА -->
            <ScrollViewer Grid.Column="1" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Auto"
                          Padding="0,0,5,0">
                <Border Style="{StaticResource CardStyle}" 
                        Background="White" 
                        Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="txtScheduleTitle" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1976D2" 
                                   Margin="0,0,0,15"/>

                        <!-- ТАБЛИЦА РАСПИСАНИЯ -->
                        <Grid x:Name="scheduleTableGrid" Margin="0,0,0,15"/>

                        <TextBlock x:Name="txtNoSchedule" 
                                   Text="📭 Нет доступных расписаний" 
                                   FontSize="16" 
                                   Foreground="#999999" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   Margin="0,50,0,50" 
                                   Visibility="Collapsed"/>

                        <!-- ПОДСВЕТКА ПОИСКА -->
                        <Border x:Name="searchHighlightPanel" 
                                Background="#FFF8E1" 
                                Padding="12" 
                                CornerRadius="8" 
                                Margin="0,0,0,15" 
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍 " FontSize="15"/>
                                <TextBlock x:Name="txtSearchQuery" Text="" FontWeight="SemiBold" 
                                           Foreground="#F57C00" VerticalAlignment="Center" FontSize="13"/>
                                <TextBlock Text=" — результаты поиска" Foreground="#757575" 
                                           VerticalAlignment="Center" Margin="5,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- ЛЕГЕНДА -->
                        <Border Background="#F8F9FA" Padding="14" CornerRadius="8" BorderBrush="#E8E8E8" BorderThickness="1">
                            <WrapPanel>
                                <TextBlock Text="📌 " FontSize="14" VerticalAlignment="Center"/>
                                <Border Background="#E8F5E9" Width="16" Height="16" CornerRadius="3" Margin="0,0,4,0"/>
                                <TextBlock Text="план урока" Foreground="#757575" FontSize="11" Margin="0,0,15,0"/>
                                <Border Background="#FFF3E0" Width="16" Height="16" CornerRadius="3" Margin="0,0,4,0"/>
                                <TextBlock Text="заметка" Foreground="#757575" FontSize="11" Margin="0,0,15,0"/>
                                <Border Background="#FFEBEE" Width="16" Height="16" CornerRadius="3" Margin="0,0,4,0"/>
                                <TextBlock Text="отменен" Foreground="#757575" FontSize="11" Margin="0,0,15,0"/>
                                <Border Background="#E3F2FD" Width="16" Height="16" CornerRadius="3" Margin="0,0,4,0"/>
                                <TextBlock Text="редактирование" Foreground="#757575" FontSize="11"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>