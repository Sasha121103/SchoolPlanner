<Window x:Class="SchoolPlanner.Pages.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SchoolPlanner.Pages"
        mc:Ignorable="d"
        Title="Электронный журнал"
        Height="800" 
        Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5" Icon="/log.png">

    <Window.Resources>
        <!-- Цветовая схема -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FF9800"/>
        <SolidColorBrush x:Key="DangerColor" Color="#F44336"/>
        <SolidColorBrush x:Key="ChangedColor" Color="#FFC107"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#757575"/>
        <SolidColorBrush x:Key="BgColor" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <!-- Конвертеры -->
        <local:GradeToVisibilityConverter x:Key="GradeToVisibilityConverter"/>

        <!-- Стиль для карточки -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.08" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки -->
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для маленьких кнопок -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ячейки -->
        <Style x:Key="GradeCellStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль для заголовка колонки -->
        <Style x:Key="HeaderCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>

        <!-- Стиль для чередования строк -->
        <Style x:Key="AlternatingRowStyle" TargetType="ListViewItem">
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter Property="Background" Value="White"/>
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8F9FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="0" 
                Style="{StaticResource CardStyle}" 
                Margin="10,10,10,5" 
                Padding="15,12,15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                       Content="← Назад" 
                       Style="{StaticResource MainButtonStyle}"
                       Background="#78909C"
                       Padding="15,8,15,8"
                       Width="100"
                       Click="btnBack_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="📖 Электронный журнал" 
                              FontSize="22" 
                              FontWeight="Bold"
                              Foreground="{StaticResource PrimaryColor}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtClassName" 
                              FontSize="18" 
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextSecondaryColor}"
                              VerticalAlignment="Center"
                              Margin="15,0,0,0"/>
                    <Border Background="{StaticResource PrimaryLightColor}"
                            CornerRadius="12"
                            Padding="10,4,10,4"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="txtStudentCount" 
                                   Text="0 уч." 
                                   Foreground="{StaticResource PrimaryColor}"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </Border>
                    <!-- НАЗВАНИЕ ПРЕДМЕТА -->
                    <Border Background="{StaticResource SuccessColor}"
                            CornerRadius="12"
                            Padding="12,4,12,4"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="txtSubjectName" 
                                   Text="Предмет" 
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="14"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White"
                            CornerRadius="6"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1,1,1,1"
                            Padding="2,2,2,2">
                        <ComboBox x:Name="cmbSubject" 
                                  Width="180"
                                  Padding="8,5,8,5"
                                  Margin="0,0,10,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectionChanged="cmbSubject_SelectionChanged"/>
                    </Border>

                    <Border Background="White"
                            CornerRadius="6"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1,1,1,1"
                            Padding="2,2,2,2">
                        <ComboBox x:Name="cmbPeriod" 
                                  Width="140"
                                  Padding="8,5,8,5"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectionChanged="cmbPeriod_SelectionChanged">
                            <ComboBoxItem Content="📅 Текущая неделя"/>
                            <ComboBoxItem Content="📅 Прошлая неделя"/>
                            <ComboBoxItem Content="📅 Этот месяц"/>
                            <ComboBoxItem Content="📅 Все даты" IsSelected="True"/>
                        </ComboBox>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- СТРОКА СТАТУСА -->
        <Border Grid.Row="1" 
                Background="#FFF8E1" 
                Padding="12,6,12,6"
                Margin="10,0,10,5"
                CornerRadius="6"
                BorderBrush="#FFE0B2"
                BorderThickness="1,1,1,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStatusInfo" 
                          Grid.Column="0"
                          Text="📝 Двойной клик - редактировать | ПКМ - меню | ↑↓←→ - навигация"
                          Foreground="#E65100"
                          FontSize="12"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          TextWrapping="Wrap"/>

                <Border Grid.Column="1"
                        Background="#FFE0B2"
                        CornerRadius="4"
                        Padding="8,4,8,4"
                        Margin="10,0,0,0">
                    <TextBlock x:Name="txtSelectedCell" 
                               Text="📍 не выбрано"
                               Foreground="#BF360C"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ЛЕГЕНДА -->
        <Border Grid.Row="2" 
                Background="#F5F5F5" 
                Padding="10,5,10,5"
                Margin="10,0,10,5"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Оценки: " FontWeight="SemiBold" Foreground="#333333" Margin="0,0,5,0"/>
                <Border Background="#4CAF50" CornerRadius="3" Padding="6,2" Margin="0,0,5,0">
                    <TextBlock Text="5" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
                <Border Background="#2196F3" CornerRadius="3" Padding="6,2" Margin="0,0,5,0">
                    <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
                <Border Background="#FF9800" CornerRadius="3" Padding="6,2" Margin="0,0,5,0">
                    <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
                <Border Background="#F44336" CornerRadius="3" Padding="6,2" Margin="0,0,10,0">
                    <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>

                <TextBlock Text="| Посещаемость: " FontWeight="SemiBold" Foreground="#333333" Margin="10,0,5,0"/>
                <TextBlock Text="✅" Margin="0,0,3,0"/>
                <TextBlock Text="Присутств." Foreground="#666666" FontSize="11" Margin="0,0,10,0"/>
                <TextBlock Text="❌" Margin="0,0,3,0"/>
                <TextBlock Text="Отсутств." Foreground="#666666" FontSize="11" Margin="0,0,10,0"/>
                <TextBlock Text="⏰" Margin="0,0,3,0"/>
                <TextBlock Text="Опоздал" Foreground="#666666" FontSize="11" Margin="0,0,10,0"/>
                <TextBlock Text="📝" Margin="0,0,3,0"/>
                <TextBlock Text="Уважительная" Foreground="#666666" FontSize="11"/>

                <Border Background="#FFC107" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                    <TextBlock Text="⚠️ Изменено" Foreground="#333333" FontWeight="SemiBold" FontSize="10"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ОСНОВНАЯ ТАБЛИЦА -->
        <ScrollViewer Grid.Row="3" 
                      Margin="10,0,10,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

            <Border Style="{StaticResource CardStyle}" 
                    Background="White"
                    MinWidth="800">
                <StackPanel>
                    <!-- Заголовок таблицы -->
                    <Border Background="{StaticResource PrimaryColor}" 
                            Padding="12,8,12,8" 
                            CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                      Text="👤 Ученик" 
                                      Foreground="White" 
                                      FontWeight="Bold"
                                      FontSize="14"
                                      VerticalAlignment="Center"/>

                            <ScrollViewer Grid.Column="1" 
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Hidden">
                                <StackPanel x:Name="spDateHeaders" 
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Список учеников -->
                    <ListView x:Name="lvJournal" 
                              BorderThickness="0"
                              Background="Transparent"
                              AlternationCount="2"
                              ItemContainerStyle="{StaticResource AlternatingRowStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              MouseLeftButtonUp="lvJournal_MouseLeftButtonUp">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F0F0F0" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="8,6,8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Имя ученика -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StudentName}" 
                                                      FontWeight="SemiBold"
                                                      FontSize="13"
                                                      TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding AverageGrade}" 
                                                      FontSize="11"
                                                      Foreground="{StaticResource TextSecondaryColor}"
                                                      Visibility="{Binding HasGrades}"/>
                                            <TextBlock Text="{Binding ChangeInfo}" 
                                                      FontSize="10"
                                                      Foreground="{StaticResource ChangedColor}"
                                                      Visibility="{Binding HasChanges}"/>
                                        </StackPanel>

                                        <!-- Ячейки -->
                                        <ScrollViewer Grid.Column="1" 
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Hidden">
                                            <ItemsControl x:Name="icGrades" 
                                                          ItemsSource="{Binding Grades}"
                                                          HorizontalAlignment="Left">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="2,0,2,0">
                                                            <!-- Оценка -->
                                                            <Border Style="{StaticResource GradeCellStyle}"
                                                                    Background="{Binding Color}"
                                                                    BorderBrush="{Binding BorderColor}"
                                                                    BorderThickness="{Binding BorderThickness}"
                                                                    ToolTip="{Binding Tooltip}"
                                                                    Tag="{Binding}"
                                                                    MouseLeftButtonDown="GradeCell_MouseLeftButtonDown"
                                                                    MouseRightButtonUp="GradeCell_MouseRightButtonUp">
                                                                <TextBlock Text="{Binding GradeDisplay}" 
                                                                          FontWeight="Bold"
                                                                          Foreground="White"
                                                                          FontSize="15"/>
                                                            </Border>

                                                            <!-- Посещаемость -->
                                                            <TextBlock Text="{Binding AttendanceText}" 
                                                                       FontSize="16"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,2,0,0"
                                                                       ToolTip="{Binding AttendanceTooltip}"
                                                                       Tag="{Binding}"
                                                                       MouseLeftButtonDown="AttendanceCell_MouseLeftButtonDown"
                                                                       Cursor="Hand"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Низ таблицы - статистика -->
                    <Border Background="{StaticResource BgColor}" 
                            Padding="12,12,12,12" 
                            CornerRadius="0,0,8,8"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                      Text="📊 Итоги по предмету" 
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextSecondaryColor}"
                                      FontSize="12"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource PrimaryLightColor}"
                                        CornerRadius="4"
                                        Padding="8,4,8,4"
                                        Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐ Средний балл: " Foreground="{StaticResource TextSecondaryColor}" FontSize="11"/>
                                        <TextBlock x:Name="txtAvgGrade" Text="—" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFF3E0"
                                        CornerRadius="4"
                                        Padding="8,4,8,4"
                                        Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋 Посещаемость: " Foreground="{StaticResource TextSecondaryColor}" FontSize="11"/>
                                        <TextBlock x:Name="txtAttendance" Text="—" Foreground="{StaticResource WarningColor}" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#E8F5E9"
                                        CornerRadius="4"
                                        Padding="8,4,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📝 Оценок: " Foreground="{StaticResource TextSecondaryColor}" FontSize="11"/>
                                        <TextBlock x:Name="txtTotalGrades" Text="0" Foreground="{StaticResource SuccessColor}" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFF8E1"
                                        CornerRadius="4"
                                        Padding="8,4,8,4"
                                        Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ Изменений: " Foreground="{StaticResource TextSecondaryColor}" FontSize="11"/>
                                        <TextBlock x:Name="txtChanges" Text="0" Foreground="{StaticResource ChangedColor}" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- НИЖНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="4" 
                Style="{StaticResource CardStyle}" 
                Margin="10,0,10,10" 
                Padding="12,10,12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel x:Name="teacherButtons" Orientation="Horizontal">
                        <Button x:Name="btnAddGrade" 
                               Content="➕ Добавить оценку" 
                               Style="{StaticResource MainButtonStyle}"
                               Background="{StaticResource SuccessColor}"
                               Padding="14,8,14,8"
                               Margin="0,0,8,0"
                               Click="btnAddGrade_Click"/>

                        <Button x:Name="btnAddAttendance" 
                               Content="📋 Отметить посещаемость" 
                               Style="{StaticResource MainButtonStyle}"
                               Background="{StaticResource WarningColor}"
                               Padding="14,8,14,8"
                               Margin="0,0,8,0"
                               Click="btnAddAttendance_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="adminButtons" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="btnViewLogs" 
                               Content="📋 История изменений" 
                               Style="{StaticResource MainButtonStyle}"
                               Background="{StaticResource ChangedColor}"
                               Padding="14,8,14,8"
                               Margin="0,0,8,0"
                               Click="btnViewLogs_Click"/>
                    </StackPanel>

                    <Button x:Name="btnExportJournal" 
                           Content="📤 Экспорт"
                           Style="{StaticResource MainButtonStyle}"
                           Background="{StaticResource PrimaryColor}"
                           Padding="14,8,14,8"
                           Margin="0,0,8,0"
                           Click="btnExportJournal_Click"/>

                    <Button x:Name="btnRefresh" 
                           Content="🔄"
                           Style="{StaticResource MainButtonStyle}"
                           Background="#78909C"
                           Padding="10,8,10,8"
                           Width="40"
                           Margin="0,0,8,0"
                           Click="btnRefresh_Click"
                           ToolTip="Обновить"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#E8F5E9"
                            CornerRadius="4"
                            Padding="8,4,8,4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="⌨️ Режим навигации" 
                                   Foreground="{StaticResource SuccessColor}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Button x:Name="btnClose" 
                           Content="✕ Закрыть" 
                           Style="{StaticResource MainButtonStyle}"
                           Background="#78909C"
                           Padding="20,8,20,8"
                           Click="btnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>