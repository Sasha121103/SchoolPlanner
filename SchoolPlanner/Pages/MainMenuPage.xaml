<Page x:Class="SchoolPlanner.Pages.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      Title="Главное меню"
      Background="#F8F9FC"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1990"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Градиенты для карточек -->
        <LinearGradientBrush x:Key="WelcomeGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2196F3" Offset="0"/>
            <GradientStop Color="#21CBF3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LessonConstructorGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7B1FA2" Offset="0"/>
            <GradientStop Color="#9C27B0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ScheduleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4CAF50" Offset="0"/>
            <GradientStop Color="#8BC34A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="StudentsGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6F00" Offset="0"/>
            <GradientStop Color="#FFB300" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="FgosGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9C27B0" Offset="0"/>
            <GradientStop Color="#673AB7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="UVRGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF9800" Offset="0"/>
            <GradientStop Color="#F44336" Offset="1"/>
        </LinearGradientBrush>

        <!-- Тени для карточек -->
        <DropShadowEffect x:Key="CardShadow" 
                         BlurRadius="15" 
                         Opacity="0.1" 
                         ShadowDepth="3"
                         Direction="270"
                         Color="#000000"/>

        <DropShadowEffect x:Key="HoverShadow" 
                         BlurRadius="20" 
                         Opacity="0.15" 
                         ShadowDepth="5"
                         Direction="270"
                         Color="#000000"/>

        <!-- Стиль для кнопок с закругленными углами -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="25"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для маленьких кнопок -->
        <Style x:Key="SmallRoundedButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для элемента списка -->
        <Style TargetType="ListViewItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  PanningMode="Both"
                  Background="{x:Null}">
        <StackPanel Margin="30" MaxWidth="1200" HorizontalAlignment="Center">

            <!-- Приветственная секция -->
            <Border CornerRadius="20" 
                    Margin="0,0,0,25"
                    Effect="{StaticResource CardShadow}">
                <Border Background="{StaticResource WelcomeGradient}" 
                        CornerRadius="20">
                    <Grid Margin="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="txtWelcome" 
                                      FontSize="32" 
                                      FontWeight="Light"
                                      Foreground="White"
                                      Text="Добро пожаловать!"/>
                            <TextBlock x:Name="txtWelcomeName" 
                                      FontSize="28" 
                                      FontWeight="SemiBold"
                                      Foreground="White"
                                      Margin="0,5,0,0"/>
                            <TextBlock x:Name="txtDate" 
                                      FontSize="16" 
                                      Foreground="White" 
                                      Opacity="0.9"
                                      Margin="0,15,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" 
                                  Text="📚" 
                                  FontSize="64" 
                                  Foreground="White"
                                  Opacity="0.3"
                                  RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="10"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Border>
            </Border>

            <!-- Статистика -->
            <Border CornerRadius="20" 
                    Background="White" 
                    Margin="0,0,0,30"
                    Padding="20"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Карточка планов -->
                    <Border Grid.Column="0" 
                            Background="#E3F2FD" 
                            CornerRadius="15"
                            Margin="5"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="📚" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtPlansCount" 
                                      FontSize="36" 
                                      FontWeight="Bold" 
                                      Foreground="#1976D2"
                                      HorizontalAlignment="Center"
                                      Text="0"/>
                            <TextBlock Text="Планов уроков" 
                                      Foreground="#1976D2" 
                                      FontSize="14"
                                      Opacity="0.8"
                                      HorizontalAlignment="Center"
                                      Margin="0,5"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка расписаний -->
                    <Border Grid.Column="1" 
                            Background="#E8F5E9" 
                            CornerRadius="15"
                            Margin="5"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="📅" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtSchedulesCount" 
                                      FontSize="36" 
                                      FontWeight="Bold" 
                                      Foreground="#2E7D32"
                                      HorizontalAlignment="Center"
                                      Text="0"/>
                            <TextBlock Text="Расписаний" 
                                      Foreground="#2E7D32" 
                                      FontSize="14"
                                      Opacity="0.8"
                                      HorizontalAlignment="Center"
                                      Margin="0,5"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка учащихся -->
                    <Border Grid.Column="2" 
                            Background="#FFF3E0" 
                            CornerRadius="15"
                            Margin="5"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="👥" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtStudentsCount" 
                                      FontSize="36" 
                                      FontWeight="Bold" 
                                      Foreground="#F57C00"
                                      HorizontalAlignment="Center"
                                      Text="0"/>
                            <TextBlock Text="Учащихся" 
                                      Foreground="#F57C00" 
                                      FontSize="14"
                                      Opacity="0.8"
                                      HorizontalAlignment="Center"
                                      Margin="0,5"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка ФГОС -->
                    <Border Grid.Column="3" 
                            Background="#F3E5F5" 
                            CornerRadius="15"
                            Margin="5"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtFgosCount" 
                                      FontSize="36" 
                                      FontWeight="Bold" 
                                      Foreground="#9C27B0"
                                      HorizontalAlignment="Center"
                                      Text="0"/>
                            <TextBlock Text="Файлов ФГОС" 
                                      Foreground="#9C27B0" 
                                      FontSize="14"
                                      Opacity="0.8"
                                      HorizontalAlignment="Center"
                                      Margin="0,5"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Основные разделы -->
            <TextBlock Text="Основные разделы" 
                      FontSize="24" 
                      FontWeight="SemiBold" 
                      Foreground="#333333"
                      Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Конструктор уроков -->
                <Border Grid.Column="0" 
                        CornerRadius="20"
                        Background="White"
                        Cursor="Hand"
                        Effect="{StaticResource CardShadow}"
                        MouseLeftButtonUp="ConstructorCard_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Effect" Value="{StaticResource HoverShadow}"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Border Background="{StaticResource LessonConstructorGradient}" 
                                CornerRadius="20"
                                Opacity="0.1"
                                Height="100"
                                VerticalAlignment="Top"/>

                        <StackPanel Margin="30">
                            <TextBlock Text="📘" FontSize="64" HorizontalAlignment="Center"/>
                            <TextBlock Text="Конструктор уроков" 
                                      FontSize="24" 
                                      FontWeight="Bold" 
                                      Foreground="#333333" 
                                      HorizontalAlignment="Center"
                                      Margin="0,15"/>
                            <TextBlock Text="Создавайте уникальные планы уроков с интерактивными элементами" 
                                      Foreground="#666666" 
                                      TextWrapping="Wrap"
                                      TextAlignment="Center"
                                      FontSize="14"
                                      Margin="0,10"/>

                            <Grid Margin="0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#4CAF50" FontSize="10" Margin="0,0,3,0"/>
                                    <TextBlock Text="12 шаблонов" Foreground="#666666" FontSize="12" Margin="0,0,15,0"/>
                                    <TextBlock Text="●" Foreground="#FF9800" FontSize="10" Margin="0,0,3,0"/>
                                    <TextBlock Text="5 предметов" Foreground="#666666" FontSize="12"/>
                                </StackPanel>

                                <Button Grid.Column="1" 
                                       x:Name="btnConstructor" 
                                       Content="Перейти →" 
                                       Style="{StaticResource RoundedButtonStyle}"
                                       Background="{StaticResource LessonConstructorGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Padding="15,8"
                                       HorizontalAlignment="Right"
                                       Cursor="Hand"
                                       Click="btnConstructor_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Расписание -->
                <Border Grid.Column="2" 
                        CornerRadius="20"
                        Background="White"
                        Cursor="Hand"
                        Effect="{StaticResource CardShadow}"
                        MouseLeftButtonUp="ScheduleCard_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Effect" Value="{StaticResource HoverShadow}"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Border Background="{StaticResource ScheduleGradient}" 
                                CornerRadius="20"
                                Opacity="0.1"
                                Height="100"
                                VerticalAlignment="Top"/>

                        <StackPanel Margin="30">
                            <TextBlock Text="📅" FontSize="64" HorizontalAlignment="Center"/>
                            <TextBlock Text="Расписание" 
                                      FontSize="24" 
                                      FontWeight="Bold" 
                                      Foreground="#333333" 
                                      HorizontalAlignment="Center"
                                      Margin="0,15"/>
                            <TextBlock Text="Управляйте расписанием уроков и отслеживайте изменения" 
                                      Foreground="#666666" 
                                      TextWrapping="Wrap"
                                      TextAlignment="Center"
                                      FontSize="14"
                                      Margin="0,10"/>

                            <Grid Margin="0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#4CAF50" FontSize="10" Margin="0,0,3,0"/>
                                    <TextBlock Text="16 классов" Foreground="#666666" FontSize="12" Margin="0,0,15,0"/>
                                    <TextBlock Text="●" Foreground="#2196F3" FontSize="10" Margin="0,0,3,0"/>
                                    <TextBlock Text="28 учителей" Foreground="#666666" FontSize="12"/>
                                </StackPanel>

                                <Button Grid.Column="1" 
                                       x:Name="btnSchedule" 
                                       Content="Перейти →" 
                                       Style="{StaticResource RoundedButtonStyle}"
                                       Background="{StaticResource ScheduleGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Padding="15,8"
                                       HorizontalAlignment="Right"
                                       Cursor="Hand"
                                       Click="btnSchedule_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Вторая строка карточек -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Учащиеся -->
                <Border Grid.Column="0" 
                        CornerRadius="20"
                        Background="White"
                        Cursor="Hand"
                        Effect="{StaticResource CardShadow}"
                        MouseLeftButtonUp="StudentsCard_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Effect" Value="{StaticResource HoverShadow}"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Border Background="{StaticResource StudentsGradient}" 
                                CornerRadius="20"
                                Opacity="0.1"
                                Height="100"
                                VerticalAlignment="Top"/>

                        <StackPanel Margin="30">
                            <TextBlock Text="👥" FontSize="64" HorizontalAlignment="Center"/>
                            <TextBlock Text="Учащиеся" 
                                      FontSize="24" 
                                      FontWeight="Bold" 
                                      Foreground="#333333" 
                                      HorizontalAlignment="Center"
                                      Margin="0,15"/>
                            <TextBlock Text="Просмотр и управление списком учащихся по классам" 
                                      Foreground="#666666" 
                                      TextWrapping="Wrap"
                                      TextAlignment="Center"
                                      FontSize="14"
                                      Margin="0,10"/>

                            <Grid Margin="0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#4CAF50" FontSize="10" Margin="0,0,3,0"/>
                                    <TextBlock Text="16 классов" Foreground="#666666" FontSize="12" Margin="0,0,15,0"/>
                                    <TextBlock Text="●" Foreground="#FF9800" FontSize="10" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="txtStudentsCountSmall" Text="0 уч." Foreground="#666666" FontSize="12"/>
                                </StackPanel>

                                <Button Grid.Column="1" 
                                       x:Name="btnStudents" 
                                       Content="Перейти →" 
                                       Style="{StaticResource RoundedButtonStyle}"
                                       Background="{StaticResource StudentsGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Padding="15,8"
                                       HorizontalAlignment="Right"
                                       Cursor="Hand"
                                       Click="btnStudents_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Файлы ФГОС -->
                <Border Grid.Column="2" 
                        CornerRadius="20"
                        Background="White"
                        Cursor="Hand"
                        Effect="{StaticResource CardShadow}"
                        MouseLeftButtonUp="FgosCard_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Effect" Value="{StaticResource HoverShadow}"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Border Background="{StaticResource FgosGradient}" 
                                CornerRadius="20"
                                Opacity="0.1"
                                Height="100"
                                VerticalAlignment="Top"/>

                        <StackPanel Margin="30">
                            <TextBlock Text="📋" FontSize="64" HorizontalAlignment="Center"/>
                            <TextBlock Text="Файлы ФГОС" 
                                      FontSize="24" 
                                      FontWeight="Bold" 
                                      Foreground="#333333" 
                                      HorizontalAlignment="Center"
                                      Margin="0,15"/>
                            <TextBlock Text="Управление файлами ФГОС по предметам" 
                                      Foreground="#666666" 
                                      TextWrapping="Wrap"
                                      TextAlignment="Center"
                                      FontSize="14"
                                      Margin="0,10"/>

                            <Grid Margin="0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#4CAF50" FontSize="10" Margin="0,0,3,0"/>
                                    <TextBlock Text="PDF, DOC" Foreground="#666666" FontSize="12" Margin="0,0,15,0"/>
                                    <TextBlock Text="●" Foreground="#9C27B0" FontSize="10" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="txtFgosCountSmall" Text="0 файлов" Foreground="#666666" FontSize="12"/>
                                </StackPanel>

                                <Button Grid.Column="1" 
                                       x:Name="btnFgos" 
                                       Content="Перейти →" 
                                       Style="{StaticResource RoundedButtonStyle}"
                                       Background="{StaticResource FgosGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Padding="15,8"
                                       HorizontalAlignment="Right"
                                       Cursor="Hand"
                                       Click="btnFgosFiles_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Кнопка входа в панель УВР -->
            <Border CornerRadius="20"
                    Margin="0,25,0,0"
                    Cursor="Hand"
                    Effect="{StaticResource CardShadow}">
                <Button x:Name="btnAdminPanel"
                        Background="{StaticResource UVRGradient}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="25,15"
                        Cursor="Hand"
                        Click="btnAdminPanel_Click"
                        HorizontalAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="20"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                                              Text="⚙" 
                                              FontSize="28" 
                                              Foreground="White"
                                              Margin="0,0,15,0"/>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="Панель управления (УВР)" 
                                                  FontSize="20" 
                                                  FontWeight="SemiBold" 
                                                  Foreground="White"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="Управление учителями, классами, кабинетами и шкалой трудности" 
                                                  FontSize="13" 
                                                  Foreground="White" 
                                                  Opacity="0.85"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" 
                                              Text="→" 
                                              FontSize="24" 
                                              Foreground="White"
                                              Margin="15,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- Панель УВР -->
            <Border x:Name="uvrPanel" 
                    CornerRadius="20"
                    Margin="0,30,0,0"
                    Effect="{StaticResource CardShadow}"
                    Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFF8E1" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel Margin="25">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="⚡" 
                                  FontSize="28" 
                                  Foreground="#F44336"
                                  Margin="0,0,10,0"/>

                        <TextBlock Grid.Column="1" 
                                  Text="Панель управления (УВР)" 
                                  FontSize="22" 
                                  FontWeight="SemiBold" 
                                  Foreground="#F44336"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0">
                            <Border Background="#F5F5F5" CornerRadius="15" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="📋 Планы на проверке" 
                                              FontSize="16" 
                                              FontWeight="SemiBold" 
                                              Foreground="#FF9800"
                                              Margin="0,0,0,15"/>

                                    <ListView x:Name="lvPendingPlans" 
                                             MaxHeight="200"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             BorderThickness="0"
                                             Background="Transparent">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10"
                                                        Background="White"
                                                        Margin="0,0,0,10"
                                                        Padding="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" 
                                                                      FontWeight="SemiBold" 
                                                                      FontSize="14"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                                                <TextBlock Text="{Binding Subject}" 
                                                                          Foreground="#2196F3" 
                                                                          FontSize="12"/>
                                                                <TextBlock Text=" • " 
                                                                          Foreground="#666666" 
                                                                          FontSize="12"/>
                                                                <TextBlock Text="{Binding Class}" 
                                                                          Foreground="#666666" 
                                                                          FontSize="12"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <Button Grid.Column="1" 
                                                                Content="Проверить" 
                                                                Style="{StaticResource SmallRoundedButtonStyle}"
                                                                Background="#FF9800"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                Padding="12,6"
                                                                FontSize="12"
                                                                Tag="{Binding Id}"
                                                                Cursor="Hand"
                                                                Click="btnCheckPlan_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Правая колонка -->
                        <StackPanel Grid.Column="2">
                            <Border Background="#E3F2FD" CornerRadius="15" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Быстрые действия" 
                                              FontSize="18" 
                                              FontWeight="SemiBold" 
                                              Foreground="#1976D2"
                                              Margin="0,0,0,15"/>

                                    <Button Content="📊 Отчет по нагрузке учителей" 
                                           Style="{StaticResource RoundedButtonStyle}"
                                           Background="#1976D2"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Padding="12"
                                           Margin="0,0,0,10"
                                           Cursor="Hand"
                                           Click="btnTeacherLoadReport_Click"/>

                                    <Button Content="📋 Список классов" 
                                           Style="{StaticResource RoundedButtonStyle}"
                                           Background="#2E7D32"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Padding="12"
                                           Margin="0,0,0,10"
                                           Cursor="Hand"
                                           Click="btnClassList_Click"/>

                                    <Button Content="📁 Архив расписаний" 
                                           Style="{StaticResource RoundedButtonStyle}"
                                           Background="#F57C00"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Padding="12"
                                           Margin="0,0,0,10"
                                           Cursor="Hand"
                                           Click="btnArchive_Click"/>

                                    <Button Content="📥 Импорт учащихся" 
                                           Style="{StaticResource RoundedButtonStyle}"
                                           Background="#9C27B0"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Padding="12"
                                           Cursor="Hand"
                                           Click="btnImportStudents_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Панель учителя -->
            <Border x:Name="teacherPanel" 
                    CornerRadius="20"
                    Margin="0,30,0,0"
                    Effect="{StaticResource CardShadow}"
                    Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E8F5E9" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel Margin="25">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="👨‍🏫" 
                                  FontSize="28" 
                                  Foreground="#2E7D32"
                                  Margin="0,0,10,0"/>

                        <TextBlock Grid.Column="1" 
                                  Text="Панель учителя" 
                                  FontSize="22" 
                                  FontWeight="SemiBold" 
                                  Foreground="#2E7D32"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Button Content="👥 Список учащихся" 
                                   Style="{StaticResource RoundedButtonStyle}"
                                   Background="#2E7D32"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Padding="15"
                                   Margin="0,0,0,10"
                                   Cursor="Hand"
                                   Click="btnStudents_Click"/>

                            <Button Content="📋 Файлы ФГОС" 
                                   Style="{StaticResource RoundedButtonStyle}"
                                   Background="#9C27B0"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Padding="15"
                                   Margin="0,0,0,10"
                                   Cursor="Hand"
                                   Click="btnFgosView_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Background="#F5F5F5" CornerRadius="15" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Мои заметки" 
                                              FontSize="16" 
                                              FontWeight="SemiBold" 
                                              Foreground="#2E7D32"
                                              Margin="0,0,0,15"/>

                                    <TextBlock Text="Выберите урок в расписании, чтобы добавить заметку" 
                                              Foreground="#666666"
                                              TextWrapping="Wrap"
                                              FontSize="12"
                                              Margin="0,0,0,15"/>

                                    <Button Content="📅 Перейти к расписанию" 
                                           Style="{StaticResource SmallRoundedButtonStyle}"
                                           Background="#2E7D32"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Padding="12"
                                           Cursor="Hand"
                                           Click="btnSchedule_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Последние планы -->
            <Border CornerRadius="20"
                    Background="White"
                    Margin="0,30,0,0"
                    Padding="25"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="📋" 
                                  FontSize="24" 
                                  Margin="0,0,10,0"/>

                        <TextBlock Grid.Column="1" 
                                  Text="Последние планы уроков" 
                                  FontSize="20" 
                                  FontWeight="SemiBold" 
                                  Foreground="#333333"/>
                    </Grid>

                    <ListView x:Name="lvRecentPlans" 
                             MaxHeight="300"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10"
                                        Background="#F8F9FC"
                                        Margin="0,0,0,10"
                                        Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" 
                                                      FontWeight="SemiBold"
                                                      FontSize="15"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8">
                                                <TextBlock Text="{Binding Subject}" 
                                                          Foreground="#2196F3"
                                                          FontSize="13"/>
                                                <TextBlock Text=" • " 
                                                          Foreground="#666666"
                                                          FontSize="13"/>
                                                <TextBlock Text="{Binding Class}" 
                                                          Foreground="#666666"
                                                          FontSize="13"/>
                                                <TextBlock Text=" • " 
                                                          Foreground="#666666"
                                                          FontSize="13"/>
                                                <TextBlock Text="{Binding CreatedDate, StringFormat='dd MMM yyyy'}" 
                                                          Foreground="#666666"
                                                          FontSize="13"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" 
                                                CornerRadius="20"
                                                Padding="12,5"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                            <Setter Property="Background" Value="#9E9E9E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Background" Value="#FF9800"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                            <Setter Property="Background" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="RequiresRevision">
                                                            <Setter Property="Background" Value="#F44336"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" 
                                                      Foreground="White"
                                                      FontSize="11"
                                                      FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Футер -->
            <Border CornerRadius="15"
                    Background="#F0F2F5"
                    Margin="0,30,0,0"
                    Padding="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Школьный Планировщик" 
                              Foreground="#666666" 
                              FontSize="12"
                              FontWeight="SemiBold"/>
                    <TextBlock Text=" • " 
                              Foreground="#CCCCCC" 
                              FontSize="12"
                              Margin="5,0"/>
                    <TextBlock Text="Версия 2.0" 
                              Foreground="#999999" 
                              FontSize="12"/>
                    <TextBlock Text=" • " 
                              Foreground="#CCCCCC" 
                              FontSize="12"
                              Margin="5,0"/>
                    <TextBlock Text="Сделано с ❤ для учителей" 
                              Foreground="#999999" 
                              FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>