<Page x:Class="SchoolPlanner.Pages.StudentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Учащиеся"
      Background="#F0F2F5"
      Loaded="Page_Loaded"
      d:DesignHeight="800" d:DesignWidth="1200">

    <Page.Resources>
        <!-- Цветовая схема -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FF9800"/>
        <SolidColorBrush x:Key="DangerColor" Color="#F44336"/>
        <SolidColorBrush x:Key="PurpleColor" Color="#9C27B0"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#757575"/>
        <SolidColorBrush x:Key="BgColor" Color="#F8F9FA"/>

        <!-- Стиль для карточки -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" Opacity="0.08" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для основной кнопки -->
        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для маленьких кнопок -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для тега -->
        <Style x:Key="TagStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
        </Style>

        <!-- Шаблон для элемента списка учеников -->
        <DataTemplate x:Key="StudentItemTemplate">
            <Border BorderBrush="#F0F0F0" 
                    BorderThickness="0,0,0,1" 
                    Padding="12,10"
                    Background="Transparent"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding FullName}" 
                                  FontWeight="SemiBold"
                                  FontSize="14"
                                  Foreground="{StaticResource TextPrimaryColor}"/>
                        <TextBlock Text="{Binding ClassName}" 
                                  Foreground="{StaticResource TextSecondaryColor}"
                                  FontSize="12"
                                  Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" 
                            Style="{StaticResource TagStyle}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ClassName}" 
                                  FontSize="10"
                                  Foreground="{StaticResource PrimaryColor}"
                                  FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================
             ВЕРХНЯЯ ПАНЕЛЬ
             ============================================================ -->
        <Border Grid.Row="0" 
                Style="{StaticResource CardStyle}" 
                Margin="12" 
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                       Content="← На главную" 
                       Style="{StaticResource MainButtonStyle}"
                       Background="#78909C"
                       Padding="16,10"
                       Width="140"
                       Click="btnBack_Click"/>

                <TextBlock Grid.Column="1" 
                          Text="👥 Учащиеся" 
                          FontSize="22" 
                          FontWeight="Bold"
                          Foreground="{StaticResource PrimaryColor}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>

                <Border Grid.Column="2"
                        Background="{StaticResource PrimaryLightColor}"
                        CornerRadius="8"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="txtRoleIndicator" 
                               Text="👤 УВР" 
                               Foreground="{StaticResource PrimaryColor}"
                               FontWeight="SemiBold"
                               FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================
             ОСНОВНОЙ КОНТЕНТ
             ============================================================ -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================
                 ЛЕВАЯ ПАНЕЛЬ - СПИСОК УЧЕНИКОВ
                 ============================================================ -->
            <Border Grid.Column="0" 
                    Style="{StaticResource CardStyle}" 
                    Background="White"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource BgColor}"
                            BorderBrush="#F0F0F0"
                            BorderThickness="0,0,0,1"
                            Padding="16,16">
                        <StackPanel>
                            <TextBlock Text="🏫 Классы" 
                                      FontSize="18" 
                                      FontWeight="Bold" 
                                      Foreground="{StaticResource TextPrimaryColor}"
                                      Margin="0,0,0,12"/>

                            <!-- Кнопка добавления ученика -->
                            <Button x:Name="btnAddStudent" 
                                   Content="➕ Добавить ученика"
                                   Style="{StaticResource MainButtonStyle}"
                                   Background="{StaticResource SuccessColor}"
                                   Padding="16,10"
                                   HorizontalAlignment="Stretch"
                                   Click="btnAddStudent_Click"
                                   Visibility="Collapsed"/>

                            <!-- Кнопка импорта -->
                            <Button x:Name="btnImportStudents" 
                                   Content="📥 Импорт из CSV"
                                   Style="{StaticResource MainButtonStyle}"
                                   Background="{StaticResource PurpleColor}"
                                   Padding="16,10"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,4,0,4"
                                   Click="btnImportStudents_Click"
                                   Visibility="Collapsed"/>

                            <!-- Кнопка экспорта -->
                            <Button x:Name="btnExportStudents" 
                                   Content="📤 Экспорт в CSV"
                                   Style="{StaticResource MainButtonStyle}"
                                   Background="{StaticResource PrimaryColor}"
                                   Padding="16,10"
                                   HorizontalAlignment="Stretch"
                                   Click="btnExportStudents_Click"
                                   Visibility="Collapsed"/>

                            <!-- Фильтр по классам -->
                            <ComboBox x:Name="cmbClassFilter" 
                                     Margin="0,12,0,0"
                                     Padding="12,10"
                                     SelectedIndex="0"
                                     SelectionChanged="cmbClassFilter_SelectionChanged">
                                <ComboBoxItem Content="📌 Все классы"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Список -->
                    <ListView x:Name="lvStudents" 
                             Grid.Row="1"
                             SelectionMode="Single"
                             ItemTemplate="{StaticResource StudentItemTemplate}"
                             SelectionChanged="lvStudents_SelectionChanged"/>

                    <!-- Статистика -->
                    <Border Grid.Row="2" 
                            Background="{StaticResource BgColor}"
                            BorderBrush="#F0F0F0"
                            BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥 " Foreground="{StaticResource PrimaryColor}" FontSize="14"/>
                            <TextBlock x:Name="txtStats" 
                                      Text="Всего учеников: 0"
                                      Foreground="{StaticResource TextSecondaryColor}"
                                      FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================
                 ПРАВАЯ ПАНЕЛЬ - ИНФОРМАЦИЯ ОБ УЧЕНИКЕ
                 ============================================================ -->
            <Border Grid.Column="1" 
                    Style="{StaticResource CardStyle}" 
                    Background="White"
                    Padding="24"
                    Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Заголовок с аватаркой -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource PrimaryLightColor}"
                                    CornerRadius="25"
                                    Width="50"
                                    Height="50"
                                    Margin="0,0,15,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1" 
                                      x:Name="txtStudentName" 
                                      Text="Выберите ученика" 
                                      FontSize="22" 
                                      FontWeight="Bold"
                                      Foreground="{StaticResource PrimaryColor}"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Информационная карточка -->
                        <Border Background="{StaticResource BgColor}" 
                                CornerRadius="8" 
                                Padding="16"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                          Text="📚 Класс" Foreground="{StaticResource TextSecondaryColor}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                          Text="🎂 Дата рождения" Foreground="{StaticResource TextSecondaryColor}" FontWeight="SemiBold" FontSize="12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                          x:Name="txtClass" Text="—" Foreground="{StaticResource TextPrimaryColor}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                          x:Name="txtBirthDate" Text="—" Foreground="{StaticResource TextPrimaryColor}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Кнопка перехода в журнал -->
                        <Button x:Name="btnOpenJournal" 
                               Content="📖 Открыть журнал" 
                               Style="{StaticResource MainButtonStyle}"
                               Background="{StaticResource WarningColor}"
                               Padding="20,12"
                               HorizontalAlignment="Center"
                               Width="200"
                               Margin="0,0,0,20"
                               Click="btnOpenJournal_Click"/>

                        <!-- Краткая статистика -->
                        <Border Background="{StaticResource PrimaryLightColor}" 
                                CornerRadius="8" 
                                Padding="16"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtAvgGrade" Text="—" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Средний балл" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtTotalGrades" Text="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Оценок" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="📅" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtAttendancePercent" Text="0%" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Посещаемость" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Кнопки действий -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8">
                            <Button x:Name="btnEditStudent" 
                                   Content="✏ Редактировать" 
                                   Style="{StaticResource MainButtonStyle}"
                                   Background="{StaticResource PrimaryColor}"
                                   Padding="20,10"
                                   Click="btnEditStudent_Click"/>
                            <Button x:Name="btnDeleteStudent" 
                                   Content="🗑️ Удалить" 
                                   Style="{StaticResource MainButtonStyle}"
                                   Background="{StaticResource DangerColor}"
                                   Padding="20,10"
                                   Margin="8,0,0,0"
                                   Click="btnDeleteStudent_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>