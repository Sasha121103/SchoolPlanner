<Window x:Class="SchoolPlanner.Pages.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История изменений" 
        Height="500" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5" Icon="/log.png">

    <Window.Resources>
        <!-- Тень для карточек -->
        <DropShadowEffect x:Key="DropShadowEffect" 
                          BlurRadius="10" 
                          Opacity="0.08" 
                          ShadowDepth="2"
                          Direction="270"/>

        <!-- Стиль для кнопки с закругленными углами -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Цвета для статусов -->
        <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FF9800"/>
        <SolidColorBrush x:Key="DangerColor" Color="#F44336"/>
        <SolidColorBrush x:Key="InfoColor" Color="#2196F3"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#757575"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="White" 
                Padding="15" 
                CornerRadius="8" 
                Margin="0,0,0,10"
                Effect="{StaticResource DropShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                          Text="📋 История изменений" 
                          FontSize="20" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource PrimaryColor}"/>

                <TextBlock Grid.Column="1" 
                          x:Name="txtClassInfo" 
                          Text="" 
                          Foreground="{StaticResource TextSecondaryColor}" 
                          FontSize="14"
                          Margin="0,0,15,0"/>

                <Button Grid.Column="2" 
                        Content="🔄 Обновить" 
                        Style="{StaticResource RoundedButtonStyle}"
                        Background="{StaticResource InfoColor}"
                        Padding="12,6"
                        Click="btnRefresh_Click"/>
            </Grid>
        </Border>

        <!-- Список логов -->
        <ListView x:Name="lvLogs" 
                  Grid.Row="1" 
                  Background="White" 
                  BorderBrush="#E0E0E0" 
                  BorderThickness="1"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Дата" 
                                    Width="150" 
                                    DisplayMemberBinding="{Binding Date, StringFormat='dd.MM.yyyy HH:mm'}"/>
                    <GridViewColumn Header="Пользователь" 
                                    Width="150" 
                                    DisplayMemberBinding="{Binding UserName}"/>
                    <GridViewColumn Header="Действие" 
                                    Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" 
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        Background="{Binding ActionColor}">
                                    <TextBlock Text="{Binding ActionText}" 
                                              Foreground="White"
                                              FontWeight="SemiBold"
                                              FontSize="12"
                                              Padding="4,2"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Ученик" 
                                    Width="150" 
                                    DisplayMemberBinding="{Binding StudentName}"/>
                    <GridViewColumn Header="Предмет" 
                                    Width="120" 
                                    DisplayMemberBinding="{Binding Subject}"/>
                    <GridViewColumn Header="Изменение" 
                                    Width="250" 
                                    DisplayMemberBinding="{Binding Comment}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" 
                Background="White" 
                Padding="15" 
                CornerRadius="8" 
                Margin="0,10,0,0"
                Effect="{StaticResource DropShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Всего записей: " 
                              Foreground="{StaticResource TextSecondaryColor}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtTotal" 
                              Text="0" 
                              Foreground="{StaticResource PrimaryColor}"
                              FontWeight="Bold"
                              FontSize="14"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="✕ Закрыть" 
                        Width="100" 
                        Padding="10,8" 
                        Background="#78909C" 
                        Foreground="White" 
                        BorderThickness="0"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="btnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>