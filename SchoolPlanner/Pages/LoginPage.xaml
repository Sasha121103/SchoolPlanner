<Page x:Class="SchoolPlanner.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход в систему"
      Background="#F5F5F5">

    <Grid>
        <Border Width="400" Height="450" 
                Background="White" 
                CornerRadius="10"
                Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#CCCCCC" Direction="315" ShadowDepth="3" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Школьный Планировщик" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="#2196F3"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30"/>

                <TextBlock Text="Вход в систему" 
                          FontSize="18" 
                          Foreground="#666666"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30"/>

                <TextBlock Text="Логин" Foreground="#666666" Margin="0,5"/>
                <TextBox x:Name="txtUsername" 
                        Height="40" 
                        Padding="10"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Text="admin"/>

                <TextBlock Text="Пароль" Foreground="#666666" Margin="0,15,0,5"/>
                <PasswordBox x:Name="txtPassword" 
                            Height="40" 
                            Padding="10"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            Password="admin123"/>

                <Button x:Name="btnLogin" 
                       Content="Войти" 
                       Style="{StaticResource MainButtonStyle}"
                       Margin="0,30,0,0"
                       Click="btnLogin_Click"/>

                <TextBlock x:Name="txtStatus" 
                          Foreground="Red" 
                          HorizontalAlignment="Center"
                          Margin="0,20,0,0"
                          Visibility="Collapsed"/>

                <TextBlock Text="Тестовые учетные записи:" 
                          Foreground="#999999" 
                          FontSize="12"
                          Margin="0,20,0,0"/>
                <TextBlock Text="admin / admin123 (УВР)" 
                          Foreground="#999999" 
                          FontSize="11"/>
                <TextBlock Text="aleksandrova / 123 (Учитель)" 
                          Foreground="#999999" 
                          FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>