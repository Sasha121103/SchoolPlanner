<Window x:Class="SchoolPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Школьный Планировщик" 
        Height="600" 
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip" Icon="/log.png">

    <Window.Resources>
        <DropShadowEffect x:Key="PanelShadow" 
                         BlurRadius="15" 
                         Opacity="0.15" 
                         ShadowDepth="2"
                         Color="#000000"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Effect="{StaticResource PanelShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1565C0" Offset="0"/>
                    <GradientStop Color="#1E88E5" Offset="0.5"/>
                    <GradientStop Color="#42A5F5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏫" 
                              FontSize="24" 
                              Foreground="White"
                              Margin="0,0,10,0"/>
                    <TextBlock Text="Школьный Планировщик" 
                              Foreground="White" 
                              FontSize="18" 
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Часы и дата -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="20,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- Иконка часов -->
                        <TextBlock Text="🕐" 
                                  FontSize="18" 
                                  Foreground="#1565C0"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>
                        <!-- Время -->
                        <TextBlock x:Name="txtClock" 
                                  Foreground="#1565C0" 
                                  FontSize="24" 
                                  FontWeight="SemiBold"
                                  FontFamily="Segoe UI, Arial"
                                  Text="00:00:00"
                                  VerticalAlignment="Center"/>

                        <!-- Разделитель -->
                        <TextBlock Text="|" 
                                  Foreground="#BBDEFB"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Margin="12,0,12,0"/>

                        <!-- Иконка календаря -->
                        <TextBlock Text="📅" 
                                  FontSize="16" 
                                  Foreground="#1565C0"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>

                        <!-- Дата -->
                        <TextBlock x:Name="txtDate" 
                                  Foreground="#1565C0" 
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Text="00.00.0000"
                                  VerticalAlignment="Center"/>

                        <!-- Разделитель -->
                        <TextBlock Text="|" 
                                  Foreground="#BBDEFB"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Margin="12,0,12,0"/>

                        <!-- Иконка дня недели -->
                        <TextBlock Text="📆" 
                                  FontSize="16" 
                                  Foreground="#1565C0"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>

                        <!-- День недели -->
                        <TextBlock x:Name="txtDayOfWeek" 
                                  Foreground="#1565C0" 
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Text="Понедельник"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Пользователь и выход -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White"
                            CornerRadius="8"
                            Padding="15,7"
                            Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" 
                                      FontSize="14" 
                                      Foreground="#1565C0"
                                      Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtUserInfo" 
                                      Foreground="#1565C0" 
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="btnLogout" 
                           Content="Выход" 
                           Foreground="White" 
                           Background="Transparent"
                           BorderThickness="1"
                           BorderBrush="White"
                           Padding="15,7"
                           Cursor="Hand"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Click="btnLogout_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF" />
                                        <Setter Property="Opacity" Value="0.2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF" />
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <!-- Свернуть -->
                    <Button Content="─" 
                           Foreground="White" 
                           Background="Transparent"
                           BorderThickness="0"
                           FontSize="18"
                           Width="32"
                           Height="32"
                           Cursor="Hand"
                           Click="btnMinimize_Click"
                           ToolTip="Свернуть">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Width="{TemplateBinding Width}"
                                        Height="{TemplateBinding Height}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF" />
                                        <Setter Property="Opacity" Value="0.15"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Развернуть (квадрат) -->
                    <Button Content="☐" 
                           Foreground="White" 
                           Background="Transparent"
                           BorderThickness="0"
                           FontSize="18"
                           Width="32"
                           Height="32"
                           Cursor="Hand"
                           Margin="5,0,0,0"
                           Click="btnMaximize_Click"
                           ToolTip="Развернуть">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Width="{TemplateBinding Width}"
                                        Height="{TemplateBinding Height}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF" />
                                        <Setter Property="Opacity" Value="0.15"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Закрыть -->
                    <Button Content="✕" 
                           Foreground="White" 
                           Background="Transparent"
                           BorderThickness="0"
                           FontSize="16"
                           Width="32"
                           Height="32"
                           Cursor="Hand"
                           Margin="5,0,0,0"
                           Click="btnClose_Click"
                           ToolTip="Закрыть">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Width="{TemplateBinding Width}"
                                        Height="{TemplateBinding Height}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E53935"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame" 
               Grid.Row="1" 
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>